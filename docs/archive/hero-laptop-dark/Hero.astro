---
import { site } from '../../data/site';
import DitherCanvas from '../DitherCanvas.astro';
import PixelLaptop from '../PixelLaptop.astro';

/**
 * Each entry drives both halves of the hero: `tail` completes the headline, and
 * `ask` / `results` are what the laptop shows for that query.
 *
 * `tail` is kept short on purpose — it must sit on one line inside its highlight
 * block at 320px, which is roughly 21 characters.
 *
 * Shop names are invented.
 */
const searches = [
  {
    tail: '500 shirts printed.',
    ask: 'who prints 500 tees in Dallas',
    results: ['Crosstown Print Co.', 'Trinity Ink Works', 'Bluebonnet Apparel'],
  },
  {
    tail: '300 hoodies stitched.',
    ask: 'contract embroidery, 300 pcs',
    results: ['Lone Star Threadworks', 'Crosstown Embroidery', 'Redbird Stitch Co.'],
  },
  {
    tail: 'DTF under 24 pieces.',
    ask: 'DTF shop, low minimums',
    results: ['Nightshift DTF', 'Cardinal Transfer Co.', 'Junction Print Lab'],
  },
  {
    tail: 'uniforms for a team.',
    ask: 'team uniforms, 2 week turn',
    results: ['Halfmoon Athletic', 'Trinity Ink Works', 'Ridgeline Uniform Co.'],
  },
  {
    tail: 'contract screenprint.',
    ask: 'contract screen printing near me',
    results: ['Junction Print Lab', 'Crosstown Print Co.', 'Eastside Press'],
  },
];

const first = searches[0];
---

<section class="hero">
  <div class="container">
    <div class="hero__frame">
      <DitherCanvas seed={site.familyShopSince} />

      <div class="hero__content">
        <h1 class="hero__title">
          <span class="hero__line">
            <span class="mark"
              >Buyers are asking <br class="hero__br" />AI where to get</span
            >
          </span>
          <span class="hero__line">
            <span class="mark hero__rot" data-rotator={JSON.stringify(searches)}>
              <span class="hero__rot-view">
                <span class="hero__rot-word">{first.tail}</span>
              </span>
            </span>
          </span>
        </h1>

        <p class="hero__sub">
          BriteUX gets decorators and distributors named in that answer.
        </p>

        <div class="hero__actions">
          <a class="pill pill--primary pill--lg" href="/contact/">
            Talk to us<span class="pill__chev" aria-hidden="true"></span>
          </a>
          <a
            class="pill pill--quiet pill--lg"
            href="/answers/what-an-ai-visibility-audit-checks/"
          >
            What we check
          </a>
        </div>
      </div>

      <div class="hero__stage">
        <PixelLaptop ask={first.ask} results={first.results} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 0;
  }

  .hero__frame {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Taller than the landscape-only hero, because the laptop has to sit in the
       frame without crowding the lock-up above it — but only by enough. */
    min-height: 520px;
    margin-inline: calc(var(--rail-inset) * -1);
    padding-block: 40px 0;
    background: var(--sky);
    overflow: hidden;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    min-width: 0;
    padding-inline: 16px;
    /* The minimum gap to the laptop. Any slack left over by the frame's
       min-height goes to the stage's auto top margin, so the screen always
       finishes flush at the bottom edge however tall the frame ends up. */
    margin-bottom: 30px;
    text-align: center;
  }

  .hero__title {
    display: block;
    max-width: 100%;
    font-size: var(--fs-h1);
    line-height: 1.34;
  }

  .hero__line {
    display: block;
    text-wrap: balance;
  }

  .hero__rot {
    display: inline-block;
    max-width: 100%;
    overflow: hidden;
    vertical-align: bottom;
    transition: width 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .hero__rot-view {
    display: block;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
    overflow: hidden;
  }

  /* The rotating tail always occupies exactly one line. Every phrase is short
     enough to hold at 320px, and nowrap guarantees it rather than hoping. */
  .hero__rot-word {
    display: block;
    white-space: nowrap;
    will-change: transform, opacity;
  }

  .hero__rot[data-anim='out'] .hero__rot-word {
    transform: translateY(-108%);
    opacity: 0;
    transition:
      transform 200ms cubic-bezier(0.55, 0, 1, 0.45),
      opacity 160ms linear;
  }

  .hero__rot[data-anim='in'] .hero__rot-word {
    transform: translateY(108%);
    opacity: 0;
  }

  .hero__rot[data-anim='settle'] .hero__rot-word {
    transform: translateY(0);
    opacity: 1;
    transition:
      transform 300ms cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 200ms linear;
  }

  .hero__sub {
    margin-top: 16px;
    max-width: 40ch;
    font-size: var(--fs-hero-sub);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--grey-800);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-width: 0;
    max-width: 420px;
    margin-top: 22px;
  }

  .hero__actions .pill {
    flex: 1 1 140px;
    min-width: 0;
    padding-inline: 12px;
  }

  /* In flow, with a negative bottom margin. The margin pulls the frame's bottom
     edge up past the screen, and `overflow: hidden` crops what is left — so the
     laptop rises out of the section edge with no base showing.
     
     This has to stay in flow: absolutely positioned, the gap above the laptop
     was whatever the frame's fixed height happened to leave, which collapsed to
     6px at 320px where the copy wraps most. In flow the gap is the margin, at
     every width, and the frame grows to fit. */
  .hero__stage {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 620px;
    margin: auto auto -18px;
    padding-inline: 16px;
  }

  @media (min-width: 30rem) {
    .hero__actions .pill {
      padding-inline: 22px;
    }

    .hero__br {
      display: none;
    }
  }

  @media (min-width: 48rem) {
    .hero__frame {
      min-height: min(84vh, 780px);
      padding-block: 76px 0;
    }

    .hero__content {
      margin-bottom: 46px;
    }

    .hero__stage {
      margin-bottom: -26px;
    }
  }
</style>

<script>
  /**
   * Drives both halves of the hero from one list: the rotating tail of the
   * headline, and the query and results on the laptop screen.
   *
   * The laptop types in monospace with `steps()` set to the exact character
   * count, which is what gives it the old-terminal cadence rather than a fade.
   *
   * Accessibility:
   *  - Nothing runs under `prefers-reduced-motion`. The markup already renders
   *    the first query fully resolved, so that is what stays.
   *  - Pauses on hover, on keyboard focus inside the hero, and while the tab is
   *    hidden.
   *  - `aria-live="off"`: the heading is read once, as rendered.
   */
  type Search = { tail: string; ask: string; results: string[] };

  const root = document.querySelector<HTMLElement>('[data-rotator]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && !reduced) {
    const view = root.querySelector<HTMLElement>('.hero__rot-view');
    const word = root.querySelector<HTMLElement>('.hero__rot-word');
    const askEl = document.querySelector<HTMLElement>('[data-lt-ask]');
    const rows = [...document.querySelectorAll<HTMLElement>('[data-lt-row]')];

    let items: Search[] = [];
    try {
      items = JSON.parse(root.dataset.rotator || '[]');
    } catch {
      items = [];
    }

    if (view && word && items.length > 1) {
      root.setAttribute('aria-live', 'off');

      const ruler = document.createElement('span');
      ruler.setAttribute('aria-hidden', 'true');
      ruler.style.cssText =
        'position:absolute;left:-9999px;top:0;white-space:nowrap;pointer-events:none';
      root.appendChild(ruler);

      const measure = (text: string) => {
        const cs = getComputedStyle(word);
        ruler.style.font = cs.font;
        ruler.style.letterSpacing = cs.letterSpacing;
        ruler.textContent = text;
        return ruler.getBoundingClientRect().width;
      };

      const boxWidth = (text: string) => {
        const cs = getComputedStyle(root);
        return (
          measure(text) + parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight) + 1
        );
      };

      const wide = matchMedia('(min-width: 48rem)');
      const lock = () => {
        root.style.width = wide.matches
          ? `${boxWidth(word.textContent || '')}px`
          : '';
      };
      lock();
      addEventListener('resize', lock, { passive: true });
      wide.addEventListener('change', lock);
      if (document.fonts?.ready) document.fonts.ready.then(lock).catch(() => {});

      /** Retype one line: width 0 → its own character count, in that many steps. */
      const type = (el: HTMLElement, text: string, ms: number, delay: number) => {
        el.textContent = text;
        const n = Math.max(1, text.length);
        el.style.animation = 'none';
        void el.offsetWidth;
        el.style.animation = `ltType ${n * ms}ms steps(${n}) ${delay}ms both`;
      };

      const paint = (item: Search) => {
        if (askEl) type(askEl, item.ask, 26, 0);
        rows.forEach((row, i) => {
          const name = row.querySelector<HTMLElement>('.lt__name');
          if (name) type(name, item.results[i] || '', 20, 520 + i * 260);
        });
      };

      let i = 0;
      let paused = false;
      let timer = 0;

      const step = () => {
        clearTimeout(timer);
        if (paused) {
          timer = window.setTimeout(step, 600);
          return;
        }
        const next = items[(i + 1) % items.length];

        root.dataset.anim = 'out';
        root.style.width = wide.matches ? `${boxWidth(next.tail)}px` : '';

        window.setTimeout(() => {
          word.textContent = next.tail;
          i = (i + 1) % items.length;

          root.dataset.anim = 'in';
          void word.offsetHeight;
          root.dataset.anim = 'settle';

          paint(next);
          timer = window.setTimeout(step, 4200);
        }, 210);
      };

      timer = window.setTimeout(step, 4200);

      const hero = root.closest('.hero');
      const hold = (state: boolean) => () => {
        paused = state;
      };
      hero?.addEventListener('pointerenter', hold(true));
      hero?.addEventListener('pointerleave', hold(false));
      hero?.addEventListener('focusin', hold(true));
      hero?.addEventListener('focusout', hold(false));
      document.addEventListener('visibilitychange', () => {
        paused = document.hidden;
      });
    }
  }
</script>
