---
import BaseLayout from '../layouts/BaseLayout.astro';
import Schedule from '../components/sections/Schedule.astro';
import { site, absoluteUrl } from '../data/site';
import {
  organizationSchema,
  webSiteSchema,
  localBusinessSchema,
  breadcrumbSchema,
} from '../lib/schema';

const description =
  `Book a thirty-minute meeting with ${site.name} about getting your shop found in ` +
  `Google and in AI assistants. No obligation, and nothing to prepare.`;

const schemas = [
  organizationSchema(),
  webSiteSchema(),
  localBusinessSchema(),
  breadcrumbSchema([
    { name: 'Home', url: absoluteUrl('/') },
    { name: 'Talk to us', url: absoluteUrl('/contact/') },
  ]),
];
---

<BaseLayout
  title="Talk to us"
  description={description}
  path="/contact/"
  schemas={schemas}
  ground="grey"
>
  <div class="rails">
    <Schedule />
  </div>
</BaseLayout>
