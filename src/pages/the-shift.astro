---
/**
 * The shift, in full. The home page's section states the change; this page
 * expands it with the figures behind it, which come from src/data/research.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, absoluteUrl } from '../data/site';
import { shiftRows } from '../data/shift';
import { answerEconomy as study } from '../data/research';
import {
  organizationSchema,
  webSiteSchema,
  breadcrumbSchema,
} from '../lib/schema';

const description =
  'How a buyer finds a decorator or distributor changed in about two years: ' +
  'half of business buyers now start with an AI assistant rather than a search engine.';

const schemas = [
  organizationSchema(),
  webSiteSchema(),
  breadcrumbSchema([
    { name: 'Home', url: absoluteUrl('/') },
    { name: 'The shift', url: absoluteUrl('/the-shift/') },
  ]),
];

const consequences = [
  {
    title: 'The answer is the shortlist',
    body:
      'A buyer who asks an assistant for three shops gets three shops. The list is ' +
      'made before anyone picks up a phone, and being on it is the whole game.',
    tint: 'var(--t-periwinkle)',
  },
  {
    title: 'A model can only use what it can read',
    body:
      'Minimums, run sizes and turnaround stated plainly on a page are readable. The ' +
      'same facts living in a gallery, a PDF or your head are not.',
    tint: 'var(--t-cream)',
  },
  {
    title: 'The buyer arrives informed',
    body:
      'They have already been told what you take on before they call. If that summary ' +
      'is wrong or missing, the call does not happen at all.',
    tint: 'var(--t-mint)',
  },
];
---

<BaseLayout
  title="The shift"
  description={description}
  path="/the-shift/"
  schemas={schemas}
>
  <div class="rails">
    <section class="page-hero">
      <div class="container page-hero__inner">
        <p class="label">The shift</p>
        <h1>How a buyer <span class="hi">finds a shop</span></h1>
        <p class="lead page-hero__body">
          The path changed in about two years. Most shops are still standing on the old
          one.
        </p>
        <div class="page-hero__cta">
          <a class="pill pill--primary" href="/what-we-do/">
            What we do about it<span class="pill__chev" aria-hidden="true"></span>
          </a>
          <a class="pill pill--secondary" href="/research/">
            The research<span class="pill__chev" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>

    <section class="page-band">
      <div class="container">
        <div class="page-band__head">
          <h2>The same buyer, two years apart</h2>
          <p class="lead">
            Nothing about the work changed. Everything about how the work gets found did.
          </p>
        </div>

        <div class="ts-cols">
          <div>
            <p class="label ts-col__head">Before</p>
            <ul class="checklist">
              {shiftRows.map((row) => <li><span class="chip" style="--tint: var(--grey-200)">Was</span><span>{row.before}</span></li>)}
            </ul>
          </div>
          <div>
            <p class="label ts-col__head">Now</p>
            <ul class="checklist">
              {shiftRows.map((row) => <li><span class="chip" style="--tint: var(--t-blue)">Is</span><span>{row.now}</span></li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="page-band page-band--alt">
      <div class="container">
        <div class="page-band__head">
          <h2>What {study.sampleSize} buyers told {study.publisher}</h2>
          <p class="lead">
            They were buying software, not screen printing. It is the same person at the
            same desk, and the habit does not stay in one department.
          </p>
        </div>

        <ul class="tiles tiles-4 ts-stats">
          {
            study.cards.map((card) => (
              <li class="tile tile--tint" style={`--tint: var(--t-${card.tint === 'grey' ? 'periwinkle' : card.tint})`}>
                <p class="tile__num">{card.value}</p>
                <p class="label ts-stat__label">{card.label}</p>
              </li>
            ))
          }
        </ul>

        <p class="small muted ts-source">
          Source: {study.publisher}, “{study.shortTitle}” (April 2026). Survey of {
            study.sampleSize
          } B2B software buyers across {study.regions}, {study.fieldwork}.
        </p>

        <div class="ts-cta">
          <a class="pill pill--primary" href={study.path}>
            Read the full study<span class="pill__chev" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>

    <section class="page-band">
      <div class="container">
        <div class="page-band__head">
          <h2>What it changes for a shop</h2>
        </div>

        <ul class="tiles tiles-3">
          {
            consequences.map((c) => (
              <li class="tile">
                <h3 class="ts-tile__title">{c.title}</h3>
                <p class="muted">{c.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="cta-band">
      <div class="container cta-band__inner">
        <h2>Your first month is the audit.</h2>
        <p class="small muted">
          What Google and the assistants say about your shop today, in writing.<br />
          {site.offer.terms}
        </p>
        <div class="cta-band__actions">
          <a class="pill pill--primary" href="/contact/">
            Talk to us<span class="pill__chev" aria-hidden="true"></span>
          </a>
          <a class="pill pill--secondary" href="/pricing/">
            See pricing<span class="pill__chev" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .ts-cols {
    display: grid;
    gap: 32px;
  }

  .ts-col__head {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
  }

  .ts-stat__label {
    color: var(--grey-900);
  }

  .ts-source {
    max-width: 56ch;
    margin-top: 24px;
  }

  .ts-cta {
    margin-top: 28px;
  }

  .ts-tile__title {
    font-size: var(--fs-body);
    font-weight: 600;
    letter-spacing: 0;
  }

  @media (min-width: 48rem) {
    .ts-cols {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }
</style>
