---
/**
 * The questions page.
 *
 * The FAQPage structured data stays on the home page, which carries the same
 * list — marking one set of questions up at two URLs is the kind of duplicate
 * a search engine is entitled to ignore.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site, absoluteUrl } from '../data/site';
import { homeFaq } from '../data/faq';
import {
  organizationSchema,
  webSiteSchema,
  breadcrumbSchema,
} from '../lib/schema';

const answers = (await getCollection('answers', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const description =
  'The questions a skeptical shop owner asks about BriteUX: lock-in, ownership, what ' +
  'we can and cannot promise, and what we need from you.';

const schemas = [
  organizationSchema(),
  webSiteSchema(),
  breadcrumbSchema([
    { name: 'Home', url: absoluteUrl('/') },
    { name: 'Questions', url: absoluteUrl('/questions/') },
  ]),
];
---

<BaseLayout
  title="Questions"
  description={description}
  path="/questions/"
  schemas={schemas}
>
  <div class="rails">
    <section class="page-hero">
      <div class="container page-hero__inner">
        <p class="label">Questions</p>
        <h1>The ones a <span class="hi">skeptical owner</span> asks</h1>
        <p class="lead page-hero__body">
          If yours is not here, ask it in the meeting. We would rather answer it before
          you pay us than after.
        </p>
      </div>
    </section>

    <section class="page-band page-band--alt">
      <div class="container qs__inner">
        <h2 class="qs__title">FAQs</h2>
        <div class="qs__list">
          {
            homeFaq.map((entry) => (
              <details class="qs__item">
                <summary>
                  <span>{entry.question}</span>
                  <span class="qs__chev" aria-hidden="true" />
                </summary>
                <p class="muted">{entry.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="page-band">
      <div class="container">
        <div class="page-band__head">
          <h2>Questions your buyers ask</h2>
          <p class="lead">
            The answer library is the same work we do for a client, published on our own
            site.
          </p>
        </div>

        <ul class="tiles tiles-3">
          {
            answers.slice(0, 3).map((entry) => (
              <li class="tile">
                <h3 class="qs__answer-title">
                  <a href={`/answers/${entry.id}/`}>{entry.data.title}</a>
                </h3>
                <p class="muted">{entry.data.description}</p>
              </li>
            ))
          }
        </ul>

        <div class="qs__cta">
          <a class="pill pill--secondary" href="/answers/">
            All answers<span class="pill__chev" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="container cta-band__inner">
        <h2>Ask the rest in a meeting.</h2>
        <p class="small muted">
          Thirty minutes with one of us. {site.offer.terms}
        </p>
        <div class="cta-band__actions">
          <a class="pill pill--primary" href="/contact/">
            Talk to us<span class="pill__chev" aria-hidden="true"></span>
          </a>
          <a class="pill pill--secondary" href="/pricing/">
            See pricing<span class="pill__chev" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .qs__inner {
    display: grid;
    gap: 24px;
  }

  .qs__item {
    border-top: 1px solid var(--rule);
  }

  .qs__item:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .qs__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 18px 0;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .qs__item summary::-webkit-details-marker {
    display: none;
  }

  .qs__chev {
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 200ms cubic-bezier(0.3, 0, 0.15, 1);
  }

  .qs__item[open] .qs__chev {
    transform: translateY(2px) rotate(-135deg);
  }

  .qs__item p {
    max-width: 68ch;
    padding-bottom: 20px;
  }

  .qs__answer-title {
    font-size: var(--fs-body);
    font-weight: 600;
    letter-spacing: 0;
  }

  .qs__cta {
    margin-top: 28px;
  }

  @media (min-width: 48rem) {
    .qs__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 48px;
    }
  }
</style>
