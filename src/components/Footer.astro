---
import { site } from '../data/site';
import { getCollection } from 'astro:content';
import Wordmark from './Wordmark.astro';

const answers = (await getCollection('answers', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="container">
    <div class="ftr__cols">
      <nav class="ftr__col" aria-label="Site">
        <p class="ftr__head">Site</p>
        <a class="wipe" href="/the-shift/">The shift</a>
        <a class="wipe" href="/what-we-do/">What we do</a>
        <a class="wipe" href="/research/">Research</a>
        <a class="wipe" href="/who-we-are/">Who we are</a>
        <a class="wipe" href="/pricing/">Pricing</a>
        <a class="wipe" href="/questions/">Questions</a>
      </nav>

      <div class="ftr__col">
        <p class="ftr__head">Contact</p>
        <a class="wipe" href="/contact/">Talk to us</a>
        <a class="wipe" href={`mailto:${site.email}`}>{site.email}</a>
      </div>

      <nav class="ftr__col ftr__col--wide" aria-label="Answers">
        <p class="ftr__head">Answers</p>
        {
          answers.map((entry) => (
            <a class="wipe" href={`/answers/${entry.id}/`}>{entry.data.title}</a>
          ))
        }
        <a class="wipe" href="/answers/">All answers</a>
      </nav>
    </div>

    <div class="ftr__base">
      <Wordmark />
      <p class="ftr__legal muted">
        &copy; {year} {site.legalName}. You own the domain, the profile and every
        account.
      </p>
    </div>
  </div>
</footer>

<style>
  /* White, with the orange kept for the link wipe — the fill that sweeps in
     behind a link on hover (see `.wipe` in global.css). */
  .ftr {
    /* Matches the page's ground, so the footer goes grey on a grey page. */
    background: var(--page-ground, var(--white));
    color: var(--black);
    border-top: 1px solid var(--rule);
    padding-block: 56px 32px;
  }

  .ftr__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px 24px;
  }

  /* Answer titles are whole questions. In a half-width column they shred into
     three-word lines, so this one spans the row on small screens. */
  .ftr__col--wide {
    grid-column: 1 / -1;
  }

  .ftr__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .ftr__head {
    margin-bottom: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--grey-600);
  }

  .ftr__col a {
    max-width: 30ch;
    /* Their nav links run large and medium-weight, not list-sized. */
    font-size: clamp(1.1875rem, 1.13rem + 0.23vw, 1.375rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.005em;
    color: var(--black);
  }

  .ftr__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }

  .ftr__legal {
    max-width: 46ch;
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  @media (min-width: 48rem) {
    .ftr {
      padding-block: 88px 40px;
    }

    .ftr__cols {
      grid-template-columns: 1fr 1fr 1.6fr;
      gap: 48px;
    }

    .ftr__col--wide {
      grid-column: auto;
    }
  }
</style>
