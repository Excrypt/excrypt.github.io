---
/**
 * The pixel hero.
 *
 * A procedurally generated ridge landscape, colour-quantised through an ordered
 * (Bayer 8x8) dither into a five-stop ink ramp, drawn at one-fifth resolution and
 * scaled up with `image-rendering: pixelated`. Moving the pointer across it drags
 * an "etch trail" that floods heat into the field, pushing those cells up the
 * ramp — ink spreading through a screen.
 *
 * This is the only JavaScript on the site. It is deliberate:
 *  - ~3 KB, no dependencies, no framework.
 *  - Renders once on load, then repaints only while the trail is decaying, so an
 *    untouched page costs nothing after first paint.
 *  - Nothing on the page depends on it. The canvas sits behind the text with a
 *    painted fallback colour, so if the script never runs the hero is still a
 *    solid ground with legible type over it.
 *  - Under `prefers-reduced-motion` the field is drawn once and the trail never
 *    runs.
 */
interface Props {
  /** Extra class on the wrapper. */
  class?: string;
  /** Seed the landscape so a given page always draws the same picture. */
  seed?: number;
  /**
   * `ridge` is the hero: a skyline with an ink mass below it, still until the
   * pointer touches it. `field` is a flat dither field that drifts on its own —
   * for panels below the fold, where nothing would ever hover it.
   */
  variant?: 'ridge' | 'field';
  /**
   * Which ramp to quantise into.
   *
   * `press` is the hero's own black/red/orange/lime/cream build-up. The rest are
   * narrow ramps around one colour — the base value with a darker and a lighter
   * step either side — so a filled block reads as that colour with pixels moving
   * through it rather than as a different colour altogether.
   *
   * `periwinkle` was called `sky` until the grid bands needed a ramp around
   * `--c-sky` (#00b0ff). Two different blues under one name is how you end up
   * fixing the wrong component.
   */
  tone?:
    | 'press'
    | 'grey'
    | 'periwinkle'
    | 'navy'
    | 'lime'
    | 'accent'
    | 'sky'
    | 'indigo'
    | 'blush'
    | 'lavender'
    | 'ice'
    | 'ash'
    | 'ink';
  /** Device pixels per dither cell. Smaller reads finer; costs more to paint. */
  cell?: number;
  /**
   * Repaint the cells under the pointer from a second ramp — muted blue through
   * sky to a soft near-white — instead of pushing them up the base one. Turns
   * the pointer trail from "a bit brighter here" into something that reads as
   * interactive.
   */
  hot?: boolean;
}
const {
  class: className = '',
  seed = 1987,
  variant = 'ridge',
  tone = 'press',
  cell = 5,
  hot = false,
} = Astro.props;
---

<div
  class:list={['dither', `dither--${tone}`, className]}
  data-seed={seed}
  data-variant={variant}
  data-tone={tone}
  data-cell={cell}
  data-hot={hot ? '' : undefined}
>
  <canvas class="dither__canvas pixelated" aria-hidden="true"></canvas>
</div>

<style>
  .dither {
    position: absolute;
    inset: 0;
    /* Painted fallback: if the script never runs, this is the ground. */
    background: var(--dither-ground, var(--sky));
    overflow: hidden;
  }

  .dither--grey {
    --dither-ground: var(--grey-950);
  }

  .dither--periwinkle {
    --dither-ground: var(--sky);
  }

  .dither--navy {
    --dither-ground: var(--c-navy);
  }

  .dither--lime {
    --dither-ground: var(--c-lime);
  }

  .dither--accent {
    --dither-ground: var(--accent);
  }

  .dither--sky {
    --dither-ground: var(--c-sky);
  }

  .dither--indigo {
    --dither-ground: #00008c;
  }

  .dither--blush {
    --dither-ground: var(--t-pink);
  }

  .dither--lavender {
    --dither-ground: var(--t-periwinkle);
  }

  .dither--ice {
    --dither-ground: var(--t-blue);
  }

  .dither--ash {
    --dither-ground: var(--grey-200);
  }

  .dither--ink {
    --dither-ground: var(--grey-950);
  }

  .dither__canvas {
    width: 100%;
    height: 100%;
    /* The canvas is decorative; the ground colour behind it is what matters if
       it fails to paint. */
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .dither__canvas[data-ready] {
    opacity: 1;
  }
</style>

<script>
  // Ordered 8x8 Bayer matrix, normalised to 0..1.
  const BAYER = [
    0, 32, 8, 40, 2, 34, 10, 42, 48, 16, 56, 24, 50, 18, 58, 26, 12, 44, 4, 36, 14, 46, 6,
    38, 60, 28, 52, 20, 62, 30, 54, 22, 3, 35, 11, 43, 1, 33, 9, 41, 51, 19, 59, 27, 49,
    17, 57, 25, 15, 47, 7, 39, 13, 45, 5, 37, 63, 31, 55, 23, 61, 29, 53, 21,
  ].map((v) => (v + 0.5) / 64);

  // Ink ramp, dark → hot → warm → pale. Read as a one-pass print build-up.
  // The reference's own inks: grey-950, browserbase-red, orange, lime, yellow.
  // Black is doubled so the mass stays weighted dark, as theirs is.
  const LAND = [
    [15, 15, 15],
    [15, 15, 15],
    [255, 69, 0],
    [255, 94, 25],
    [196, 214, 0],
    [255, 250, 205],
  ];
  // primary-gray #c5d3e8 with two small lifts. The steps are kept close together
  // on purpose: a wider sky ramp washes out toward the horizon and swallows the
  // pale highlight behind the subhead, which sits right on top of it.
  const SKY = [
    [197, 211, 232],
    [206, 218, 236],
    [215, 225, 240],
  ];

  /**
   * Panel ramps. Both are deliberately narrow: the chips that sit on top carry
   * their own scrim, but a wide ramp still makes the field jump around under
   * them and the panel stops reading as one surface.
   */
  const GREY = [
    [15, 15, 15],
    [15, 15, 15],
    [28, 28, 28],
    [44, 44, 44],
    [66, 66, 66],
    [92, 92, 92],
  ];

  /**
   * The hero's #c5d3e8 sky, opened out both ways. The hero's own ramp spans
   * only 197..215 because type sits directly on it; here the chips carry their
   * own scrim, and at that width the drift measured 0.14% frame to frame — it
   * was moving and you could not tell.
   */
  const BLUE = [
    [152, 175, 212],
    [173, 190, 219],
    [197, 211, 232],
    [214, 224, 240],
    [232, 238, 246],
    [248, 250, 253],
  ];

  /**
   * One-colour ramps for filled blocks: the base value in the middle, with two
   * steps down and two up. Keeping every stop on the same hue is what lets the
   * dither move without the block changing colour — the brief for these was
   * "keep the colours mostly the same".
   */
  const NAVY = [
    [0, 0, 96],
    [0, 0, 150],
    [0, 0, 205],
    [46, 46, 228],
    [104, 104, 246],
  ];

  const LIME = [
    [138, 152, 0],
    [168, 184, 0],
    [196, 214, 0],
    [214, 231, 66],
    [232, 243, 132],
  ];

  const ACCENT = [
    [176, 46, 0],
    [216, 56, 0],
    [255, 69, 0],
    [255, 116, 56],
    [255, 158, 112],
  ];

  /**
   * Deeper than NAVY, for surfaces that carry white text. White on NAVY's
   * lightest stop measures 4.28:1 — under AA for anything but large text. This
   * ramp's lightest stop is 7.55:1.
   */
  const INDIGO = [
    [0, 0, 64],
    [0, 0, 96],
    [0, 0, 140],
    [26, 26, 180],
    [59, 59, 214],
  ];

  const CYAN = [
    [0, 108, 176],
    [0, 142, 216],
    [0, 176, 255],
    [78, 202, 255],
    [148, 224, 255],
  ];

  /**
   * The pointer trail's own ramp: blue, through sky, to a soft near-white. It is
   * a separate ramp rather than more heat on the base one because pushing
   * periwinkle further up its own ramp only ever gets you a paler periwinkle —
   * there is nothing in it that reads as a deliberate response to the cursor.
   *
   * It used to run pure #0000cd → #00b0ff → #ffffff. Two problems with that: the
   * bottom of the ramp was fully saturated blue, which under the pointer read as
   * a different site rather than as the hero reacting, and the top stop was
   * paper white, which is where most of the trail's area ends up once the heat
   * gain saturates — so the trail read as glare rather than as colour.
   *
   * This ramp drops the chroma at the dark end and stops the light end at
   * #bad8f0, which is DARKER than the field's own pale stops. That inversion is
   * the point: the trail no longer competes on brightness, so it reads as a
   * patch of blue washing through the periwinkle rather than as a hole punched
   * in it, and there is no white in it at any heat.
   */
  const HOT = [
    [58, 92, 156],
    [82, 124, 188],
    [110, 158, 210],
    [146, 190, 226],
    [186, 216, 240],
  ];

  /**
   * Pastel ramps, each hovering around one of the site's tint tokens so a filled
   * shape reads as that tint with pixels moving inside it. They carry black
   * text, not white — every stop is light enough that near-black clears AA
   * comfortably, where white would fail on all of them.
   */
  const BLUSH = [
    [236, 158, 175],
    [246, 178, 192],
    [255, 192, 203],
    [255, 214, 222],
    [255, 235, 239],
  ];

  const LAVENDER = [
    [198, 208, 226],
    [214, 223, 236],
    [226, 233, 243],
    [238, 243, 249],
    [250, 252, 255],
  ];

  const ICE = [
    [150, 214, 245],
    [180, 228, 250],
    [196, 237, 255],
    [218, 244, 255],
    [240, 251, 255],
  ];

  /**
   * Neutral, and light. The `grey` ramp is the dark one, for panels that carry
   * white text; this one is for sitting BEHIND a cut-out photograph.
   *
   * It is the only ramp here with no hue at all, which is the point: the
   * portraits are black and white, and any tint in the field behind them reads
   * as a colour cast on the subject rather than as a ground. The span is kept
   * narrow — #cfcfcf to #f0f0f0, well inside the grey ramp's own steps — so the
   * field stays quiet enough that a head cut out against it does not look like
   * it was pasted onto a different picture.
   */
  const ASH = [
    [207, 207, 207],
    [219, 219, 219],
    [229, 229, 229],
    [239, 239, 239],
    [246, 246, 246],
  ];

  const RAMPS: Record<string, number[][]> = {
    press: LAND,
    grey: GREY,
    periwinkle: BLUE,
    navy: NAVY,
    lime: LIME,
    accent: ACCENT,
    sky: CYAN,
    indigo: INDIGO,
    blush: BLUSH,
    lavender: LAVENDER,
    ice: ICE,
    ash: ASH,
    ink: GREY,
  };

  const DEFAULT_CELL = 5; // device pixels per dither cell

  function makeNoise(seed: number) {
    const hash = (x: number, y: number) => {
      let h = x * 374761393 + y * 668265263 + seed * 1274126177;
      h = (h ^ (h >>> 13)) >>> 0;
      h = Math.imul(h, 1274126177) >>> 0;
      return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
    };
    const smooth = (t: number) => t * t * (3 - 2 * t);
    const value = (x: number, y: number) => {
      const xi = Math.floor(x);
      const yi = Math.floor(y);
      const xf = smooth(x - xi);
      const yf = smooth(y - yi);
      const a = hash(xi, yi);
      const b = hash(xi + 1, yi);
      const c = hash(xi, yi + 1);
      const d = hash(xi + 1, yi + 1);
      return a + (b - a) * xf + (c - a) * yf + (a - b - c + d) * xf * yf;
    };
    return (x: number, y: number, octaves = 4) => {
      let sum = 0;
      let amp = 0.5;
      let freq = 1;
      let norm = 0;
      for (let i = 0; i < octaves; i++) {
        sum += value(x * freq, y * freq) * amp;
        norm += amp;
        amp *= 0.5;
        freq *= 2.07;
      }
      return sum / norm;
    };
  }

  function init(root: HTMLElement) {
    const found = root.querySelector<HTMLCanvasElement>('.dither__canvas');
    if (!found) return;
    const context = found.getContext('2d', { alpha: false });
    if (!context) return;
    // Re-bound after the guards so both stay non-null inside the closures below.
    const canvas = found;
    const ctx = context;

    const seed = Number(root.dataset.seed || 1) || 1;
    const noise = makeNoise(seed);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const drifts = root.dataset.variant === 'field';
    const RAMP = RAMPS[root.dataset.tone || 'press'] || LAND;
    const CELL = Number(root.dataset.cell) || DEFAULT_CELL;
    const hot = root.dataset.hot !== undefined;

    let cols = 0;
    let rows = 0;
    let field: Float32Array = new Float32Array(0); // 0..1 land value, <0 = sky
    let heat: Float32Array = new Float32Array(0);
    let image: ImageData | null = null;
    let raf = 0;
    let running = false;
    let phase = 0;
    let last = 0;
    let inView = false;
    let driftTimer = 0;

    function build() {
      const rect = root.getBoundingClientRect();
      if (!rect.width || !rect.height) return false;

      cols = Math.max(1, Math.ceil(rect.width / CELL));
      rows = Math.max(1, Math.ceil(rect.height / CELL));
      canvas.width = cols;
      canvas.height = rows;

      field = new Float32Array(cols * rows);
      heat = new Float32Array(cols * rows);
      image = ctx.createImageData(cols, rows);

      // The field variant has no skyline and no prebuilt values: its picture
      // moves, so it is computed in paint against the current phase.
      if (drifts) return true;

      // Skyline: ridged noise across x. The range is kept low in the frame so
      // the text lock-up above it always sits on open sky — the picture has to
      // lose to the headline, not compete with it.
      const skyline = new Float32Array(cols);
      for (let x = 0; x < cols; x++) {
        const n = noise(x * 0.011, 0.5, 5);
        const ridge = 1 - Math.abs(n - 0.5) * 2; // creases into peaks
        skyline[x] = rows * (0.94 - ridge * 0.28);
      }

      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const i = y * cols + x;
          const top = skyline[x];
          if (y < top) {
            // Sky: a faint vertical wash so the dither has something to bite on.
            field[i] = -(0.25 + (y / rows) * 0.6);
          } else {
            // Depth below the skyline, plus two octaves of surface texture at
            // different scales, plus a light rim at the crest. The texture
            // amplitude is deliberately high: it keeps every stop of the ramp
            // mixing all the way down, which is what gives the mass its speckle
            // instead of banding into a flat black slab.
            const depth = (y - top) / Math.max(1, rows - top);
            const coarse = noise(x * 0.03, y * 0.05, 4);
            const fine = noise(x * 0.16, y * 0.19, 2);
            const rim = Math.max(0, 1 - depth * 6) * 0.42;
            // Weighted so black takes over by roughly 40% depth, leaving the
            // hot stops as a band near the crest and speckle below — which is
            // how the reference's mass reads, rather than a solid orange slab.
            const v =
              0.7 - depth * 0.8 + (coarse - 0.5) * 1.25 + (fine - 0.5) * 0.5 + rim;
            field[i] = Math.min(1, Math.max(0, v));
          }
        }
      }
      return true;
    }

    function paint() {
      if (!image) return;
      const d = image.data;
      const top = RAMP.length - 1;

      if (drifts) {
        for (let y = 0; y < rows; y++) {
          const brow = (y & 7) * 8;
          for (let x = 0; x < cols; x++) {
            const i = y * cols + x;
            // Two octaves at different rates, so the field churns rather than
            // sliding past as one sheet.
            const a = noise((x + phase) * 0.021, y * 0.03, 4);
            const b = noise((x - phase * 0.6) * 0.055, (y + phase * 0.3) * 0.07, 2);
            const bay = BAYER[brow + (x & 7)];
            const h = heat[i];

            let ramp = RAMP;
            let cap = top;
            let t;

            // Dithering the CHOICE of ramp against the same Bayer threshold is
            // what stops the trail having a hard outline: at the edge, where
            // heat is low, only some cells flip, so the two palettes interleave
            // in the same pixel grid as everything else.
            if (hot && h > 0.02 && h * 2.6 > bay) {
              ramp = HOT;
              cap = HOT.length - 1;
              // Enough gain that the centre of the trail reaches the top stop
              // and the tail falls back through sky to blue. At 1.15 it topped
              // out mid-ramp and the trail read as one flat colour; at 1.95 the
              // top stop covered most of the trail's area rather than its
              // centre, which is the other half of why it read as too white.
              t = (0.08 + (a - 0.5) * 1.15 + h * 1.5) * cap;
            } else {
              t = (0.42 + (a - 0.5) * 1.9 + (b - 0.5) * 0.55 + h) * cap;
            }

            if (t < 0) t = 0;
            if (t > cap) t = cap;
            const lo = Math.floor(t);
            const rgb = ramp[t - lo > bay ? Math.min(cap, lo + 1) : lo];
            const o = i * 4;
            d[o] = rgb[0];
            d[o + 1] = rgb[1];
            d[o + 2] = rgb[2];
            d[o + 3] = 255;
          }
        }
        ctx.putImageData(image, 0, 0);
        return;
      }

      for (let y = 0; y < rows; y++) {
        const brow = (y & 7) * 8;
        for (let x = 0; x < cols; x++) {
          const i = y * cols + x;
          const threshold = BAYER[brow + (x & 7)];
          const v = field[i];
          let rgb: number[];

          if (v < 0) {
            // Sky: dither between three near-tones.
            const t = -v * (SKY.length - 1);
            const lo = Math.min(SKY.length - 1, Math.floor(t));
            rgb = SKY[t - lo > threshold ? Math.min(SKY.length - 1, lo + 1) : lo];
          } else {
            const t = Math.min(1, v + heat[i]) * (LAND.length - 1);
            const lo = Math.min(LAND.length - 1, Math.floor(t));
            rgb = LAND[t - lo > threshold ? Math.min(LAND.length - 1, lo + 1) : lo];
          }

          const o = i * 4;
          d[o] = rgb[0];
          d[o + 1] = rgb[1];
          d[o + 2] = rgb[2];
          d[o + 3] = 255;
        }
      }
      ctx.putImageData(image, 0, 0);
    }

    function tick(now: number) {
      let alive = false;
      for (let i = 0; i < heat.length; i++) {
        if (heat[i] > 0.002) {
          heat[i] *= 0.94;
          alive = true;
        } else if (heat[i] !== 0) {
          heat[i] = 0;
        }
      }

      if (drifts) {
        // ~12fps, on a timer rather than rAF. At a five-pixel grid a higher rate
        // buys nothing and costs battery, and asking rAF for 60 frames a second
        // to use twelve of them wakes the compositor 48 times for nothing.
        if (!last) last = now;
        if (now - last >= 80) {
          phase += (now - last) * 0.004;
          last = now;
          paint();
        }
        if (inView && !document.hidden && !reduced) {
          driftTimer = window.setTimeout(() => tick(performance.now()), 80);
        } else {
          running = false;
        }
        return;
      }

      paint();
      if (alive) {
        raf = requestAnimationFrame(tick);
      } else {
        running = false;
      }
    }

    function run() {
      if (running) return;
      running = true;
      last = 0;
      if (drifts) {
        driftTimer = window.setTimeout(() => tick(performance.now()), 0);
      } else {
        raf = requestAnimationFrame(tick);
      }
    }

    function flood(clientX: number, clientY: number) {
      const rect = root.getBoundingClientRect();
      const cx = (clientX - rect.left) / CELL;
      const cy = (clientY - rect.top) / CELL;
      const r = 13;
      const y0 = Math.max(0, Math.floor(cy - r));
      const y1 = Math.min(rows - 1, Math.ceil(cy + r));
      const x0 = Math.max(0, Math.floor(cx - r));
      const x1 = Math.min(cols - 1, Math.ceil(cx + r));
      for (let y = y0; y <= y1; y++) {
        for (let x = x0; x <= x1; x++) {
          const dx = x - cx;
          const dy = y - cy;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d > r) continue;
          const i = y * cols + x;
          heat[i] = Math.min(0.85, heat[i] + (1 - d / r) * 0.3);
        }
      }
      run();
    }

    function start() {
      // A resize can land mid-decay; drop the old loop before rebuilding the
      // buffers it is reading from.
      cancelAnimationFrame(raf);
      clearTimeout(driftTimer);
      running = false;
      if (build()) {
        paint();
        canvas.dataset.ready = '';
        // The cancel above took the drift loop with it, and the only thing that
        // starts that loop is the observer below — which will not fire again
        // while the panel stays in view. ResizeObserver delivers an initial
        // observation as soon as it observes, so this path runs once on every
        // load, a moment after the observer started the loop: without this line
        // the field paints one frame and then sits frozen.
        //
        // It reads as a phone-only fault because it is not one. On a desktop
        // the first pointermove reaches `flood()`, which calls `run()` and
        // quietly restarts everything; a touch screen never sends one.
        if (drifts && inView && !reduced && !document.hidden) run();
      }
    }

    start();

    /**
     * The drifting panels sit well below the fold. Without this they would run
     * a repaint loop for the whole time the page is open, for a picture nobody
     * is looking at.
     */
    if (drifts && !reduced) {
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            inView = entries.some((e) => e.isIntersecting);
            if (inView) run();
          },
          { threshold: 0 }
        );
        io.observe(root);
      } else {
        inView = true;
        run();
      }
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden && inView) run();
      });
    }

    let resizeTimer = 0;
    const ro = new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(start, 120);
    });
    ro.observe(root);

    if (!reduced && matchMedia('(hover: hover)').matches) {
      let pending = false;
      let lx = 0;
      let ly = 0;
      addEventListener(
        'pointermove',
        (e) => {
          lx = e.clientX;
          ly = e.clientY;
          if (pending) return;
          pending = true;
          requestAnimationFrame(() => {
            pending = false;
            const rect = root.getBoundingClientRect();
            if (ly < rect.top || ly > rect.bottom) return;
            flood(lx, ly);
          });
        },
        { passive: true }
      );
    }
  }

  document.querySelectorAll<HTMLElement>('.dither').forEach(init);
</script>
