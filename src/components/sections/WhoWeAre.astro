---
/**
 * The founders.
 *
 * The portraits are cut-out black-and-white photographs on a drifting pixel
 * field — see `Portrait.astro` for why the field is the neutral `ash` ramp and
 * not one of the tinted ones.
 *
 * The two are seeded differently so the field behind each is a different
 * picture. Same seed twice and the pair reads as one image cut in half.
 *
 * Imports are static because Astro's `<Image />` resolves and optimises at
 * build time, so the files cannot come from `site.ts` as strings. The order
 * here is the order of `site.founders` — Bryce first, then Blaid.
 */
import { site } from '../../data/site';
import Portrait from '../Portrait.astro';
import portraitBryce from '../../assets/portrait-bryce.png';
import portraitBlaid from '../../assets/portrait-blaid.png';

const portraits = [portraitBryce, portraitBlaid];
const seeds = [4703, 8821];
---

<section class="section" id="who-we-are">
  <div class="container">
    <div class="section-head">
      <h2>We grew up <span class="hi">around presses</span></h2>
    </div>

    <div class="who">
      <div class="who__people">
        {
          site.founders.map((founder, i) => (
            <figure class="who__person" style={`--i:${i}`}>
              <Portrait src={portraits[i]} alt={founder.photoAlt} seed={seeds[i]} />
              <figcaption class="who__meta">
                <p class="who__name">{founder.name}</p>
                <p class="label">{founder.role}</p>
                <p class="muted who__bio">{founder.bio}</p>
              </figcaption>
            </figure>
          ))
        }
      </div>

      {/* Every claim in here is checkable against Hightech Grafix's own
          material — the year, the trade-only model, the two shifts, the
          methods. Nothing about the shop is invented, because the section it
          sits in carries two real names, two real faces and links to two real
          profiles. */}
      <div class="who__story prose">
        <p class="lead">
          The family shop opened in Arlington in {site.familyShopSince}, contract only —
          no retail, no walk-ins, nothing that competes with the people it prints for.
        </p>
        <p class="muted">
          It runs two shifts now. Screen print, embroidery and DTF go out the door under
          somebody else's name, and Blaid still sells for it. So we know what a blown
          in-hands date costs a distributor, why most jobs go wrong on the receiving dock
          rather than at the press, and why you will not quote twelve pieces in three
          colours.
        </p>
        <p class="muted">
          What nobody in that building ever solved was being found. The work that came in
          came from people who already knew the number. We are not going to explain your
          business to you. We are going to make sure that when a buyer asks a machine who
          can do the job, the machine knows your shop exists.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .who {
    display: grid;
    gap: 40px;
  }

  .who__people {
    display: grid;
    gap: 20px;
  }

  .who__person {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 10px;
    border: 1px solid var(--rule);
    border-radius: var(--r-xl);
    background: var(--white);
  }

  .who__meta {
    display: grid;
    gap: 4px;
    align-content: start;
    flex: 1;
    padding: 16px 12px 8px;
  }

  .who__name {
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .who__bio {
    margin-top: 8px;
  }

  /**
   * Below 768px the founder cards stack, as the three-job cards do: each sticks
   * below the header and the next scrolls over it, leaving a sliver.
   *
   * Same three dependencies as that section — the cards are opaque, nothing in
   * the ancestor chain scrolls (`html` is `overflow-x: clip`, not `hidden`), and
   * later cards paint over earlier ones by DOM order under the header's
   * `z-index: 30`.
   *
   * From 30rem the pair sits side by side, where sticky has nothing to do: the
   * two cards share a grid row, so neither can travel over the other. It is left
   * on rather than switched off because it costs nothing and the single-column
   * layout below 30rem is the case that matters.
   */
  @media (max-width: 47.999rem) {
    .who__person {
      position: sticky;
      /* Clears the 72px sticky header, then one step per card. */
      top: calc(84px + var(--i) * 14px);
    }
  }

  @media (min-width: 30rem) {
    .who__people {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
  }

  @media (min-width: 48rem) {
    .who {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 56px;
      align-items: start;
    }
  }
</style>
