---
import { site, formEndpoint } from '../../data/site';
---

<section class="section" id="contact">
  <div class="container">
    <div class="section-head">
      <h1>Talk to us</h1>
      <p class="lead">
        Calling is faster and you get one of us, not a scheduler. If it is easier to
        write it down, the form goes to the same place.
      </p>
    </div>

    <div class="contact">
      <div class="contact__direct">
        <p class="label">Call</p>
        <a class="contact__big tnum" href={`tel:${site.phone.e164}`}>
          {site.phone.display}
        </a>
        <p class="label contact__label-2">Email</p>
        <a class="contact__big" href={`mailto:${site.email}`}>{site.email}</a>
        <p class="small muted contact__note">
          One of the two of us picks up. If we are on press, leave a message and we call
          back the same day.
        </p>
      </div>

      <form class="contact__form" method="post" action={formEndpoint}>
        <div class="field">
          <label for="contact-name">Your name</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="contact-company">Shop or company</label>
          <input
            id="contact-company"
            name="company"
            type="text"
            autocomplete="organization"
          />
        </div>

        <div class="field">
          <label for="contact-email">Email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
        </div>

        <div class="field">
          <label for="contact-message">What do you run, and what do you need?</label>
          <textarea id="contact-message" name="message" rows="5" required></textarea>
        </div>

        <button class="pill pill--primary pill--lg" type="submit">
          Send this to us<span class="pill__chev" aria-hidden="true"></span>
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: 36px;
  }

  .contact__direct {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 24px;
    border: 1px solid var(--rule);
    border-radius: var(--r-xl);
    background: var(--white);
  }

  .contact__big {
    display: inline-block;
    padding-block: 4px;
    font-size: var(--fs-h3);
    font-weight: 500;
    letter-spacing: -0.015em;
    text-decoration: none;
    overflow-wrap: anywhere;
    justify-self: start;
  }

  .contact__label-2 {
    margin-top: 14px;
  }

  .contact__note {
    margin-top: 18px;
    max-width: 34ch;
  }

  .contact__big:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .contact__form {
    display: grid;
    gap: 18px;
    justify-items: start;
    padding: 24px;
    border: 1px solid var(--rule);
    border-radius: var(--r-xl);
    background: var(--white);
  }

  .contact__form .field {
    width: 100%;
  }

  @media (min-width: 48rem) {
    .contact {
      grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
      gap: 24px;
      align-items: start;
    }

    .contact__direct,
    .contact__form {
      padding: 32px;
    }
  }
</style>
