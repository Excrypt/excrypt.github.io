---

<section class="cta on-dark">
  <div class="container cta__inner">
    <h2 class="cta__title">
      Find out what an assistant says about your shop today.
    </h2>
    <p class="lead cta__sub">
      The audit is the first month's work. It is included, and you will see the answers
      before you decide anything.
    </p>
    <div class="cta__actions">
      <a class="pill pill--invert pill--lg" href="/contact/">
        Talk to us<span class="pill__chev" aria-hidden="true"></span>
      </a>
      <a class="pill pill--lg cta__ghost" href="/answers/">Read the answers</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--grey-950);
    color: var(--white);
    /* The same 7px halftone as the card media areas, so the darkest surface on
       the site still reads as printed. */
    background-image: radial-gradient(
      color-mix(in srgb, var(--accent) 55%, transparent) 1.4px,
      transparent 1.4px
    );
    background-size: 7px 7px;
  }

  .cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: var(--space-section);
    background: radial-gradient(
      120% 100% at 50% 0%,
      transparent 0%,
      var(--grey-950) 72%
    );
  }

  .cta__title {
    max-width: 20ch;
  }

  .cta__sub {
    max-width: 52ch;
    margin-top: 18px;
    color: var(--grey-400);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .cta__ghost {
    border-color: var(--grey-700);
    color: var(--white);
  }

  .cta__ghost:hover {
    border-color: var(--white);
  }
</style>
