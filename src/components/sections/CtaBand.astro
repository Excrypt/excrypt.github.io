---
import { site } from '../../data/site';
import DitherCanvas from '../DitherCanvas.astro';
const { offer } = site;
---

<section class="cta on-dark">
  <DitherCanvas variant="field" tone="indigo" cell={7} hot seed={2071} />

  <div class="container cta__inner">
    <h2 class="cta__title">Your first month is the audit.</h2>
    <p class="lead cta__sub">
      {offer.priceDisplay} for the first month, and it starts with the audit: what Google
      and the assistants say about your shop today, in writing. {offer.terms}
    </p>
    <div class="cta__actions">
      <a class="pill pill--invert pill--lg" href="/contact/">
        Talk to us<span class="pill__chev" aria-hidden="true"></span>
      </a>
      <a class="pill pill--lg cta__ghost" href="/answers/">Read the answers</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    /* Painted ground under the dither, and the fallback if the canvas never
       runs: deep indigo rather than the old near-black, so the band separates
       from the periwinkle above it and the orange footer below without either
       of them touching it. */
    background: #000040;
    color: var(--white);
    overflow: hidden;
  }

  .cta__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: var(--space-section);
    /* A scrim behind the lock-up only, not a fill over the whole band: the
       ramp's lightest stop already clears AA against white, so this is here to
       stop the field churning under the type, and it has to stay weak enough
       that the pixels are still the thing you notice. */
    background: radial-gradient(
      80% 62% at 50% 46%,
      color-mix(in srgb, #000028 72%, transparent) 0%,
      color-mix(in srgb, #000028 34%, transparent) 62%,
      transparent 100%
    );
  }

  .cta__title {
    max-width: 20ch;
  }

  .cta__sub {
    max-width: 52ch;
    margin-top: 18px;
    /* Lifted off grey-400: on indigo the cool grey goes muddy, and this line
       carries the price. */
    color: color-mix(in srgb, var(--white) 84%, transparent);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .cta__ghost {
    border-color: color-mix(in srgb, var(--white) 48%, transparent);
    color: var(--white);
  }

  .cta__ghost:hover {
    border-color: var(--white);
  }
</style>
