---
import { homeFaq } from '../../data/faq';
---

<section class="section" id="faq">
  <div class="container">
    <div class="section-head">
      <h2>The ones a skeptical owner asks</h2>
      <p class="lead">If yours is not here, call and ask it.</p>
    </div>

    <div class="faq">
      {
        homeFaq.map((entry) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span>{entry.question}</span>
              <span class="faq__mark" aria-hidden="true" />
            </summary>
            <div class="faq__a">
              <p class="muted">{entry.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    max-width: 820px;
    margin-inline: auto;
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    background: var(--white);
    overflow: clip;
  }

  .faq__item {
    border-top: 1px solid var(--rule);
  }

  .faq__item:first-child {
    border-top: 0;
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 22px;
    font-weight: 500;
    letter-spacing: -0.005em;
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    background: var(--grey-50);
  }

  .faq__mark {
    position: relative;
    flex: 0 0 auto;
    width: 13px;
    height: 13px;
  }

  .faq__mark::before,
  .faq__mark::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    background: var(--accent);
    transform: translateY(-50%);
  }

  .faq__mark::after {
    transform: translateY(-50%) rotate(90deg);
    transition: transform 180ms ease;
  }

  .faq__item[open] .faq__mark::after {
    transform: translateY(-50%) rotate(0deg);
  }

  .faq__a {
    padding: 0 22px 22px;
  }

  .faq__a p {
    max-width: 72ch;
  }

  /* The one animated thing on the page besides the hero canvas. */
  @supports (interpolate-size: allow-keywords) {
    .faq__item::details-content {
      overflow: hidden;
      block-size: 0;
      transition:
        block-size 220ms ease,
        content-visibility 220ms allow-discrete;
    }

    .faq__item[open]::details-content {
      block-size: auto;
    }
  }

  @media (min-width: 48rem) {
    .faq__q {
      padding-inline: 28px;
      font-size: var(--fs-lead);
    }

    .faq__a {
      padding: 0 28px 26px;
    }
  }
</style>
