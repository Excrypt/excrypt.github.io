---
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';

/** Every nav destination is now a page of its own. */
const links = [
  { href: '/the-shift/', label: 'The shift' },
  { href: '/what-we-do/', label: 'What we do' },
  { href: '/research/', label: 'Research' },
  { href: '/who-we-are/', label: 'Who we are' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/questions/', label: 'Questions' },
  { href: '/answers/', label: 'Answers' },
  { href: '/contact/', label: 'Talk to us' },
];

/** The desktop bar carries the five that matter; the rest live in the menu. */
const primary = links.slice(0, 5);
---

<header class="hdr">
  <div class="container hdr__inner">
    <Wordmark compact />

    <nav class="hdr__nav" aria-label="Main">
      {primary.map((l) => <a class="wipe" href={l.href}>{l.label}</a>)}
    </nav>

    <div class="hdr__actions">
      <a class="pill pill--primary hdr__cta" href="/contact/">
        Talk to us<span class="pill__chev" aria-hidden="true"></span>
      </a>

      {/* <details> so the menu opens and closes with no JavaScript at all. The
          script below only adds Escape, scroll-lock and close-on-navigate. */}
      <details class="menu" data-menu>
        <summary class="menu__btn">
          <span class="menu__icon" aria-hidden="true"></span>
          <span class="visually-hidden">Menu</span>
        </summary>

        <div class="menu__panel">
          <nav class="menu__links" aria-label="Menu">
            {links.slice(0, -1).map((l) => <a href={l.href}>{l.label}</a>)}
          </nav>

          {/* Two buttons sharing the row, as the reference's menu has — and
              neither repeats a link from the list above it. */}
          <div class="menu__actions">
            <a class="pill pill--secondary" href={`mailto:${site.email}`}>Email us</a>
            <a class="pill pill--primary" href="/contact/">
              Talk to us<span class="pill__chev" aria-hidden="true"></span>
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  /* Solid, not a blur over the page: the reference's own bar is an opaque
     white band with a hairline under it. */
  .hdr {
    /* The reference's bar is 3.5rem on a phone — read off its own --nav-height
       — and opens up on desktop. */
    --hdr-h: 56px;
    position: sticky;
    top: 0;
    z-index: 30;
    /* Matches the page's ground, so the bar goes grey on a grey page. */
    background: var(--page-ground, var(--white));
    border-bottom: 1px solid var(--rule);
  }

  .hdr__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: var(--hdr-h);
    padding-inline: calc(var(--gutter) - var(--rail-inset));
  }

  .hdr__nav {
    display: none;
    gap: 26px;
  }

  .hdr__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration: none;
    color: var(--grey-700);
  }

  .hdr__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hdr__cta {
    display: none;
  }

  /* --- the hamburger --- */

  /* 40px of hit area for a 20px icon: the icon matches the reference's, and the
     target stays large enough to hit with a thumb. */
  .menu__btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-right: -8px;
    cursor: pointer;
    list-style: none;
  }

  .menu__btn::-webkit-details-marker {
    display: none;
  }

  /* Three rules that fold into an X. The middle bar is the element itself; the
     outer two are its pseudo-elements, offset and then rotated onto it. */
  .menu__icon,
  .menu__icon::before,
  .menu__icon::after {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--black);
    transition:
      transform 180ms ease,
      opacity 120ms ease;
  }

  .menu__icon::before,
  .menu__icon::after {
    content: '';
    position: absolute;
  }

  .menu__icon::before {
    transform: translateY(-6px);
  }

  .menu__icon::after {
    transform: translateY(6px);
  }

  .menu[open] .menu__icon {
    background: transparent;
  }

  .menu[open] .menu__icon::before {
    transform: rotate(45deg);
  }

  .menu[open] .menu__icon::after {
    transform: rotate(-45deg);
  }

  /* --- the panel --- */

  .menu__panel {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 25;
    width: 100vw;
    height: calc(100dvh - var(--hdr-h));
    display: flex;
    flex-direction: column;
    padding: 8px var(--gutter) calc(24px + env(safe-area-inset-bottom));
    background: var(--white);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu__links {
    display: flex;
    flex-direction: column;
  }

  /* The reference's rows: 16px label, 16px of air above and below, and a rule
     between items rather than under the last one. */
  .menu__links a {
    padding: 16px 0;
    font-size: var(--fs-body);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--black);
    text-decoration: none;
  }

  .menu__links a:not(:last-child) {
    border-bottom: 1px solid var(--rule);
  }

  .menu__links a:active {
    color: var(--accent);
  }

  /* Pinned to the foot of the panel, as the reference's are. */
  .menu__actions {
    display: flex;
    gap: 10px;
    margin-top: auto;
    padding-top: 24px;
  }

  /* Hugging the label, like theirs: theirs comes to about 47px from 14px of
     padding on a 16px line. Ours needs the line-height pulled in from the
     body's 1.45 as well, or the same padding lands 6px taller. */
  .menu__actions .pill {
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    padding: 13px 18px;
    line-height: 1.2;
  }

  @media (min-width: 62.5em) {
    .hdr {
      --hdr-h: 72px;
    }

    .menu {
      display: none;
    }

    .hdr__nav {
      display: flex;
    }

    .hdr__cta {
      display: inline-flex;
    }
  }
</style>

<script>
  /**
   * The menu itself is a <details>, so it opens and closes with no JavaScript.
   * This only adds the things <details> does not: Escape to close, locking the
   * page behind the panel, and closing when a link is followed — including
   * same-page anchors, where no navigation happens to close it for us.
   */
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');

  if (menu) {
    const lock = () => {
      document.documentElement.style.overflow = menu.open ? 'hidden' : '';
    };

    menu.addEventListener('toggle', lock);

    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        menu.open = false;
        lock();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        lock();
        menu.querySelector<HTMLElement>('summary')?.focus();
      }
    });

    // A resize past the breakpoint hides the button; leaving the panel open
    // would lock scrolling with nothing on screen to close it.
    matchMedia('(min-width: 62.5em)').addEventListener('change', (e) => {
      if (e.matches && menu.open) {
        menu.open = false;
        lock();
      }
    });
  }
</script>
